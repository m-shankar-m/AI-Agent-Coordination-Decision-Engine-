REDIS_URL="redis://localhost:6379/0"
VECTOR_DB_URL="postgresql://banking_admin:secure_password@localhost:5432/banking_vector_db"

# Banking Tool Adapter Credentials (Sandbox / Legitimate Public APIs)
KYC_API_KEY=""
CREDIT_API_KEY=""
